# Copie este arquivo para ".env" para rodar no seu computador.
# O arquivo ".env" NUNCA vai para o repositório (veja o .gitignore).
# Aqui ficam só nomes de variáveis e valores de exemplo.
# Nunca coloque senhas, chaves ou tokens neste arquivo.

# Ambiente: development, test ou production
NODE_ENV=development

# Nível dos logs: debug, info, warn ou error
LOG_LEVEL=info

# Pasta onde o sistema guarda os dados quando roda no seu computador.
# (Nas execuções do GitHub, os dados ficam guardados no próprio repositório.)
DATA_DIR=./.local-data
