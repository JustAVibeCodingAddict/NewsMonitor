{
  "name": "news-monitor",
  "version": "0.1.0",
  "description": "Monitor automático de notícias, de uso pessoal.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "storage:init": "tsx scripts/storage-init.ts",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
